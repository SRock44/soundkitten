{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundKitten",
  "version": "0.1.3",
  "identifier": "com.soundkitten.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundKitten",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQTZFQTUwMDFFNjk1MzUKUldRMWxlWUJVT3FtZXZSdDFrWmpwL2ZwNFVEa3lVZUFxTTFXUHk1RXhpNEYxRUZPYUR0TlVQRjQK",
      "endpoints": ["https://updates.soundkitten.org/latest.json"]
    }
  }
}
